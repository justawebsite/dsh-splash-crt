    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "preview": "node tools/preview-server.mjs 8791"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "license": "MIT"
