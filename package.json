{
  "name": "dsh-splash-crt",
  "version": "0.2.0",
  "private": true,
  "description": "DSH 工业科技风开屏动画插件：CRT 显像管辉光字体 + 循环反色扫掠（分界线由左下至右上行进）",
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "splash", "crt"],
  "type": "module",
